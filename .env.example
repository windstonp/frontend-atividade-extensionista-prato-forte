# Prato Forte — frontend
# Copie para .env.local (desenvolvimento) ou defina estas variáveis no painel do host (deploy).
#   cp .env.example .env.local
#
# NEXT_PUBLIC_* entram no JavaScript na hora do `npm run build`: mudou, refaça o build.

# URL pública da API Laravel, sem barra no fim. Obrigatória no `npm run build`.
# Em produção, use um subdomínio do mesmo domínio do front (ex.: front em app.exemplo.com.br,
# API em api.exemplo.com.br): o login do Sanctum é por cookie e só funciona assim.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Nome do cookie de sessão do Laravel: Str::slug(APP_NAME).'-session' (ou SESSION_COOKIE do backend).
# O proxy só abre as telas logadas se enxergar esse cookie — tem que bater com o backend.
SESSION_COOKIE_NAME=prato-forte-session

# Versão mostrada em Configurações. Vazia, usa a "version" do package.json.
# NEXT_PUBLIC_APP_VERSION=

# Só para os testes E2E (Playwright): onde o Mailpit do backend responde.
# MAILPIT_URL=http://localhost:8025
